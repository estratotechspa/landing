{
  "name": "estratotech-landing",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Registro de contactos del formulario (tabla `leads`, ver migrations/0001_leads.sql).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "estratotech-leads",
      "database_id": "e45c9198-dcd8-4b64-9be8-871d1191512d",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {}
}
