{
  "name": "estratotech-landing",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Para guardar los contactos: crear la base con `npx wrangler d1 create estratotech-leads`,
  // aplicar `npx wrangler d1 migrations apply estratotech-leads --remote` y descomentar (con el database_id entregado):
  // "d1_databases": [{ "binding": "DB", "database_name": "estratotech-leads", "database_id": "REEMPLAZAR", "migrations_dir": "migrations" }],
  "previews": {}
}
